[Unit]
Description=DSH Discord gate (operator-approved Discord capability, token held via LoadCredential)
After=network-online.target dsh-discord.socket
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/dsh-discord/dsh_discord_gate.py
User=dsh-discord
Group=dsh-discord
LoadCredential=discord-bot-token:/root/dsh-discord/bot-token
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=256M
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
