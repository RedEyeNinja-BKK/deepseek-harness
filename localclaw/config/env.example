# env.example — environment variable NAME contract for the LocalClaw DSH layer.
# VALUES ARE NEVER COMMITTED. The operator stages values as root-owned 0600
# files; systemd materializes them into services (LoadCredential /
# EnvironmentFile / StateDirectory / socket activation).
#
# Derived from what the retained code, units, and deployment packs actually
# consume — not from inspecting the live root-owned env file.

# ── main DSH service (systemd/dsh.service) ───────────────────────────────────
# Set in the unit itself (not the env file):
DSH_HOME=/opt/dsh/home
# Additional variables are supplied to dsh.service via EnvironmentFile
# (root-owned 0600 on the deployment host). Names consumed by the wider
# deployment:
SWITCHYARD_API_KEY=<operator-staged>            # provider credential for the
                                                # OpenAI-compatible gateway lane

# ── sidecar services (line / discord / webgate) ─────────────────────────────
# Provided automatically by systemd — do not set manually:
STATE_DIRECTORY=<systemd StateDirectory>        # persistent listener state
CREDENTIALS_DIRECTORY=<systemd LoadCredential>  # materialized credential files
LISTEN_FDS=<systemd socket activation>          # webgate/discord socket fds
LISTEN_PID=<systemd socket activation>

# ── LoadCredential names (files operator-staged under /root/, never in Git) ─
#   integrations/line/dsh-line-inbound.service:
#     channel-secret, channel-access-token
#   integrations/discord/dsh-discord.service + dsh-discord-inbound.service:
#     discord-bot-token
#   integrations/webgate/dsh-webgate.service:
#     manager-token
#
# NOTE: any additional variable names that exist only inside the deployment
# host's root-owned env file are intentionally NOT enumerated here; that
# contract is completed on the deployment host, never in this repository.
